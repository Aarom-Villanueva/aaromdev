'use client';

import { useEffect, useRef, useState } from 'react';
import { motion, useMotionValueEvent, useReducedMotion, useScroll, useTransform } from 'framer-motion';
import { ArrowDown, Download, ArrowRight } from 'lucide-react';

const TOTAL_FRAMES = 60;
const FRAME_PATHS = Array.from({ length: TOTAL_FRAMES }, (_, index) =>
  `/hero-frames/frame-${String(index + 1).padStart(4, '0')}.webp`
);

export default function HeroSection() {
  const heroRef = useRef<HTMLElement>(null);
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const framesRef = useRef<(HTMLImageElement | null)[]>(Array.from({ length: TOTAL_FRAMES }, () => null));
  const loadingRef = useRef<(Promise<HTMLImageElement> | null)[]>(Array.from({ length: TOTAL_FRAMES }, () => null));
  const rafRef = useRef<number | null>(null);
  const resizeRafRef = useRef<number | null>(null);
  const pendingFrameRef = useRef(0);
  const currentFrameRef = useRef(-1);
  const reduceMotion = useReducedMotion() ?? false;
  const { scrollYProgress } = useScroll({ target: heroRef, offset: ['start start', 'end end'] });
  const [firstFrameReady, setFirstFrameReady] = useState(false);
  const [frameLoadError, setFrameLoadError] = useState(false);

  const clampFrameIndex = (index: number) => Math.min(TOTAL_FRAMES - 1, Math.max(0, index));

  const getCanvasContext = () => {
    const canvas = canvasRef.current;
    if (!canvas) return null;
    const context = canvas.getContext('2d');
    return context;
  };

  const resizeCanvas = () => {
    const canvas = canvasRef.current;
    if (!canvas) return;

    const rect = canvas.getBoundingClientRect();
    if (!rect.width || !rect.height) return;

    const dpr = window.devicePixelRatio || 1;
    const width = Math.round(rect.width * dpr);
    const height = Math.round(rect.height * dpr);

    if (canvas.width !== width || canvas.height !== height) {
      canvas.width = width;
      canvas.height = height;
    }

  };

  const drawFrame = (index: number) => {
    const canvas = canvasRef.current;
    const context = getCanvasContext();
    if (!canvas || !context) return;

    const frame = framesRef.current[index];
    if (!frame || !frame.complete || frame.naturalWidth === 0) return;

    const rect = canvas.getBoundingClientRect();
    if (!rect.width || !rect.height) return;

    const dpr = window.devicePixelRatio || 1;
    const displayWidth = rect.width;
    const displayHeight = rect.height;
    const pixelWidth = Math.round(displayWidth * dpr);
    const pixelHeight = Math.round(displayHeight * dpr);

    if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
      canvas.width = pixelWidth;
      canvas.height = pixelHeight;
    }

    context.setTransform(dpr, 0, 0, dpr, 0, 0);
    context.clearRect(0, 0, displayWidth, displayHeight);

    const sourceWidth = frame.naturalWidth;
    const sourceHeight = frame.naturalHeight;
    const scale = Math.max(displayWidth / sourceWidth, displayHeight / sourceHeight);
    const drawWidth = sourceWidth * scale;
    const drawHeight = sourceHeight * scale;
    const offsetX = (displayWidth - drawWidth) / 2;
    const offsetY = (displayHeight - drawHeight) / 2;

    context.drawImage(frame, offsetX, offsetY, drawWidth, drawHeight);
  };

  const scheduleDraw = (index: number) => {
    pendingFrameRef.current = clampFrameIndex(index);

    if (rafRef.current !== null) return;

    rafRef.current = window.requestAnimationFrame(() => {
      rafRef.current = null;
      const nextIndex = clampFrameIndex(pendingFrameRef.current);
      if (nextIndex === currentFrameRef.current) return;
      currentFrameRef.current = nextIndex;
      drawFrame(nextIndex);
    });
  };

  const preloadFrame = (index: number) => {
    const cached = framesRef.current[index];
    if (cached) return Promise.resolve(cached);

    const existing = loadingRef.current[index];
    if (existing) return existing;

    const promise = new Promise<HTMLImageElement>((resolve, reject) => {
      const image = new Image();
      image.decoding = 'async';
      image.src = FRAME_PATHS[index];
      image.onload = () => {
        framesRef.current[index] = image;
        loadingRef.current[index] = null;
        resolve(image);

        if (index === currentFrameRef.current) {
          drawFrame(index);
        }

        if (reduceMotion && index === TOTAL_FRAMES - 1) {
          drawFrame(index);
        }
      };
      image.onerror = () => {
        loadingRef.current[index] = null;
        reject(new Error(`Failed to load frame ${index + 1}`));
      };
    });

    loadingRef.current[index] = promise;
    return promise;
  };

  useEffect(() => {
    let cancelled = false;

    const startPreload = async () => {
      try {
        await preloadFrame(0);
        if (cancelled) return;

        setFirstFrameReady(true);
        currentFrameRef.current = 0;
        scheduleDraw(0);

        if (reduceMotion) {
          void preloadFrame(TOTAL_FRAMES - 1)
            .then(() => {
              if (cancelled) return;
              currentFrameRef.current = TOTAL_FRAMES - 1;
              scheduleDraw(TOTAL_FRAMES - 1);
            })
            .catch(() => undefined);
        }

        for (let index = 1; index < TOTAL_FRAMES; index += 1) {
          void preloadFrame(index).catch(() => {
            if (process.env.NODE_ENV !== 'production') {
              console.error(`Failed to preload hero frame ${index + 1}.`);
            }
          });
        }
      } catch {
        if (!cancelled) {
          setFrameLoadError(true);
          if (process.env.NODE_ENV !== 'production') {
            console.error('Hero frame sequence failed to start.');
          }
        }
      }
    };

    startPreload();

    return () => {
      cancelled = true;
      if (rafRef.current !== null) {
        window.cancelAnimationFrame(rafRef.current);
      }
      if (resizeRafRef.current !== null) {
        window.cancelAnimationFrame(resizeRafRef.current);
      }
    };
  }, [reduceMotion]);

  useEffect(() => {
    const host = canvasRef.current?.parentElement;
    if (!host) return;

    const handleResize = () => {
      if (resizeRafRef.current !== null) {
        window.cancelAnimationFrame(resizeRafRef.current);
      }

      resizeRafRef.current = window.requestAnimationFrame(() => {
        resizeRafRef.current = null;
        resizeCanvas();
        if (currentFrameRef.current >= 0) {
          drawFrame(currentFrameRef.current);
        }
      });
    };

    resizeCanvas();
    handleResize();

    const observer = new ResizeObserver(handleResize);
    observer.observe(host);

    window.addEventListener('resize', handleResize);

    return () => {
      observer.disconnect();
      window.removeEventListener('resize', handleResize);
    };
  }, []);

  useMotionValueEvent(scrollYProgress, 'change', (latest) => {
    if (reduceMotion || frameLoadError || !firstFrameReady) return;
    const nextIndex = clampFrameIndex(Math.round(latest * (TOTAL_FRAMES - 1)));
    scheduleDraw(nextIndex);
  });

  const titleOpacity = useTransform(scrollYProgress, [0.48, 0.67], [0, 1], { clamp: true });
  const titleY = useTransform(scrollYProgress, [0.48, 0.67], [24, 0], { clamp: true });
  const titleBlur = useTransform(scrollYProgress, [0.48, 0.67], ['blur(8px)', 'blur(0px)'], { clamp: true });

  const titleSecondOpacity = useTransform(scrollYProgress, [0.6, 0.76], [0, 1], { clamp: true });
  const titleSecondY = useTransform(scrollYProgress, [0.6, 0.76], [18, 0], { clamp: true });
  const titleSecondBlur = useTransform(scrollYProgress, [0.6, 0.76], ['blur(8px)', 'blur(0px)'], { clamp: true });

  const bodyOpacity = useTransform(scrollYProgress, [0.7, 0.88], [0, 1], { clamp: true });
  const bodyY = useTransform(scrollYProgress, [0.7, 0.88], [16, 0], { clamp: true });
  const bodyBlur = useTransform(scrollYProgress, [0.7, 0.88], ['blur(8px)', 'blur(0px)'], { clamp: true });

  const scrollIndicatorOpacity = useTransform(scrollYProgress, [0, 0.12, 0.25], [1, 1, 0], { clamp: true });
  const scrollIndicatorY = useTransform(scrollYProgress, [0, 0.25], [0, 10], { clamp: true });

  return (
    <section ref={heroRef} id="inicio" className="relative h-[300vh] bg-[#030303]">
      <div className="sticky top-0 h-screen overflow-hidden bg-[#030303]">
        <div className="absolute inset-0 z-[2] bg-black" />
        <div className="absolute inset-0 z-[5] bg-[radial-gradient(ellipse_at_center,rgba(3,3,3,0)_0%,rgba(3,3,3,0.08)_34%,rgba(3,3,3,0.24)_68%,rgba(3,3,3,0.72)_100%)]" />
        <div className="absolute inset-0 z-[6] bg-[linear-gradient(to_bottom,rgba(3,3,3,0.16),rgba(3,3,3,0.03)_24%,rgba(3,3,3,0.2)_100%)]" />
        <div className="absolute inset-0 z-[7] bg-[linear-gradient(to_right,rgba(3,3,3,0.3),rgba(3,3,3,0)_18%,rgba(3,3,3,0)_82%,rgba(3,3,3,0.3))]" />

        <div className="absolute inset-0 z-[3]">
          {!frameLoadError ? (
            <canvas
              ref={canvasRef}
              aria-hidden="true"
              className="absolute inset-0 h-full w-full"
              style={{ imageRendering: 'auto' }}
            />
          ) : null}
        </div>

        <div className="absolute inset-0 z-20 flex items-end">
          <div className="mx-auto w-full max-w-7xl px-6 pb-20 lg:px-10 lg:pb-24">
            <div className="max-w-4xl">
              <motion.h1 initial={false} className="text-display max-w-[12ch] text-white">
                <motion.span
                  initial={false}
                  style={{ opacity: reduceMotion || frameLoadError ? 1 : titleOpacity, y: reduceMotion || frameLoadError ? 0 : titleY, filter: reduceMotion || frameLoadError ? 'blur(0px)' : titleBlur }}
                  className="block"
                >
                  Construyo productos.
                </motion.span>
                <motion.span
                  initial={false}
                  style={{ opacity: reduceMotion || frameLoadError ? 1 : titleSecondOpacity, y: reduceMotion || frameLoadError ? 0 : titleSecondY, filter: reduceMotion || frameLoadError ? 'blur(0px)' : titleSecondBlur }}
                  className="block text-white/55"
                >
                  No solo proyectos.
                </motion.span>
              </motion.h1>

              <motion.p
                initial={false}
                style={{ opacity: reduceMotion || frameLoadError ? 1 : bodyOpacity, y: reduceMotion || frameLoadError ? 0 : bodyY, filter: reduceMotion || frameLoadError ? 'blur(0px)' : bodyBlur }}
                className="mt-8 max-w-2xl text-body-large text-white/55"
              >
                Desarrollo soluciones modernas con bases técnicas sólidas, arquitectura limpia y enfoque en problemas reales.
              </motion.p>

              <motion.div
                initial={false}
                style={{ opacity: reduceMotion || frameLoadError ? 1 : bodyOpacity, y: reduceMotion || frameLoadError ? 0 : bodyY, filter: reduceMotion || frameLoadError ? 'blur(0px)' : bodyBlur }}
                className="mt-10 flex flex-wrap items-center gap-4"
              >
                <a href="#proyectos" className="btn-primary">
                  Explorar proyectos <ArrowRight className="h-4 w-4" />
                </a>
                <a href="#contacto" className="btn-secondary">
                  Contactarme
                </a>
                <a href="#" className="btn-ghost">
                  <Download className="h-3.5 w-3.5" /> Descargar CV
                </a>
              </motion.div>
            </div>
          </div>
        </div>

        <motion.div
          initial={false}
          style={{ opacity: reduceMotion || frameLoadError ? 0 : scrollIndicatorOpacity, y: reduceMotion || frameLoadError ? 0 : scrollIndicatorY }}
          className="absolute bottom-6 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-2"
        >
          <span className="text-[10px] uppercase tracking-[0.2em] text-white/30">Desliza para descubrir</span>
          <ArrowDown className="scroll-indicator h-4 w-4 text-white/30" />
        </motion.div>
      </div>
    </section>
  );
}
